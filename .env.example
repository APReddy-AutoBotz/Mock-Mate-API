# MockMate Environment Variables

# Google Gemini AI API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Required)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----"

# ATS Integration API Keys (Optional - for enterprise features)
GREENHOUSE_API_KEY=your_greenhouse_api_key
LEVER_API_KEY=your_lever_api_key
WORKDAY_API_KEY=your_workday_api_key
ICIMS_API_KEY=your_icims_api_key

# Blockchain Configuration (Optional - for credential verification)
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
POLYGON_RPC_URL=https://polygon-mumbai.infura.io/v3/your_infura_project_id

# Application Configuration
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_DB_LOGGING=true
ENABLE_METRICS=true

# Security
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:5173

# Database (Optional - for additional analytics)
MONGODB_URI=mongodb://localhost:27017/mockmate
REDIS_URL=redis://localhost:6379

# External Services (Optional)
GRAFANA_PASSWORD=your_grafana_password
SLACK_WEBHOOK=your_slack_webhook_url
SNYK_TOKEN=your_snyk_token